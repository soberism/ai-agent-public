# 复制为 .env 后配置云端开发服务凭据；本地地址通过 SSH 隧道访问云服务器；禁止提交 .env。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=replace-with-cloud-dev-password
POSTGRES_DB=ai_agent
API_PORT=18000
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=replace-with-cloud-dev-password
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15673
RABBITMQ_USER=ai_agent
RABBITMQ_VHOST=ai_agent_dev
RABBITMQ_PASSWORD=replace-with-cloud-dev-password

# 本地 HTTP 调试显式关闭 Secure；其他环境必须 true。
APP_ENV=development
EMAIL_SCHEDULER_ENABLED=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:9988","http://127.0.0.1:9988"]
# 仅填写可核验代理地址；启动 uvicorn 使用 --no-proxy-headers。
TRUSTED_PROXIES=[]
REDIS_NAMESPACE=ai-agent:
# 每环境独立生成：uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
CURSOR_SECRET=

# 注册邮件：未配置时发送返回503，既有账号仍可登录。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# ssl（465）或 starttls（通常587）；禁止明文降级。
SMTP_SECURITY=ssl
APP_URL=http://localhost:9988
# 独立随机秘密，至少32字符，不复用其他密码或CURSOR_SECRET。
EMAIL_VERIFICATION_SECRET=
# OpenAI-compatible AI service. Keep the real key only in backend/.env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-a-real-key
LLM_MODEL=gpt-4.1-mini
# 使用 DeepSeek 时：LLM_BASE_URL=https://api.deepseek.com，LLM_MODEL=deepseek-chat，
# LLM_API_KEY 填 DeepSeek Key；它不能替代下面的 LangSmith Key。

# 追踪默认关闭；明确知悉外发与脱敏边界后再启用。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# 必须与 LangSmith 工作区区域一致；默认美国。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 留空按 APP_ENV 分到 ai-agent-development / ai-agent-production。
LANGSMITH_PROJECT=
# API Key 关联多个工作区时填写。
LANGSMITH_WORKSPACE_ID=
# 提示词/回答/工具数据规则脱敏后保留；凭据移除，异常详情仍隐藏。
# 自由文本个人信息识别有边界，开发排查优先使用合成数据。

EMBEDDING_MODEL=text-embedding-3-small
# 可独立指定；留空时复用下方百炼转写地址与密钥。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 百炼北京地域语音转写（独立于聊天配置，需安装 FFmpeg）
TRANSCRIPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=qwen3-asr-flash

# 摘要独立队列，需由专属 summary-worker 消费，不与回答 Worker 共用。
ASSISTANT_SUMMARY_QUEUE=assistant-summary

# 仅此账号可扫描服务器配置的IMAP邮箱；留空禁用扫描。不得填写邮箱地址。
IMAP_OWNER_ID=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# 每账号AI请求额度；窗口从首次请求起计60秒/24小时，拒绝的请求不计数。
AI_MAX_ACTIVE_RUNS=1
AI_CHAT_PER_MINUTE=20
AI_CHAT_PER_DAY=200
AI_TRANSCRIPTION_PER_MINUTE=10
AI_TRANSCRIPTION_PER_DAY=100
AI_REINDEX_PER_MINUTE=1
AI_REINDEX_PER_DAY=10
